<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>picklabel_ros</name>
  <version>0.1.0</version>
  <description>PickLabel student detector (drop-in for sam3_ros), pick logger and replay nodes for ROS 2 Jazzy</description>
  <maintainer email="waqarworks11@gmail.com">Mohd Waqar Azim</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>lifecycle_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>
  <!-- object_masks uses the same message as sam3_ros; without it the node publishes boxes only -->
  <exec_depend>sobits_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
